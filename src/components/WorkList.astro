---
// The home page's Work list: grouped by employer, each row a link to its page.
import Row from "./Row.astro";
import { WORK_GROUPS } from "../data/work";
---

<section class="wrap work" id="work" aria-labelledby="work-label" data-reveal>
  <h2 id="work-label" class="sec-label">Work</h2>
  {WORK_GROUPS.map((g) => (
    <div class="group">
      <div class="who">
        <span class="org">{g.org}</span>
        <span class="role">{g.role}</span>
        {"when" in g && <span class="when">{g.when}</span>}
      </div>
      <div class="rows">
        {g.items.map((w) => (
          <Row href={`/work/${w.id}`} seed={w.id} name={w.data.name} line={w.data.line} meta={w.data.tech.join(" · ")} />
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .work { padding-top: 96px; display: flex; flex-direction: column; gap: 20px; }
  .sec-label { font-size: 18px; font-weight: 600; color: var(--muted); margin: 0; }
  .group { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 32px; padding: 28px 0; border-top: 1px solid #262626; }
  .who { display: flex; flex-direction: column; gap: 4px; }
  .org { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; }
  .role { font-size: 14px; color: var(--muted); }
  .when { font-size: 14px; color: var(--subtle); }
  .rows { display: flex; flex-direction: column; gap: 10px; }
  @media (max-width: 1023px) { .group { grid-template-columns: 1fr; gap: 16px; } }
  @media (max-width: 767px) { .work { padding-top: 72px; } }
</style>
