---
import { Image } from "astro:assets";
import avatar from "../assets/brand/avatar.webp";
import Icon from "./Icon.astro";
import ResumeLinks from "./ResumeLinks.astro";
import { NAV_MAIN, NAV_MENU, ELSEWHERE, type PageId } from "../data/nav";

interface Props { current?: PageId; avatar?: boolean; }
const { current, avatar: showAvatar = true } = Astro.props;
const here = (id: string) => (current === id ? "page" : undefined);
---

<header class="bar">
  <div class="wrap row">
    <a href="/" class="home" aria-label="Wassim Soltani, home">
      {showAvatar && <Image src={avatar} alt="" width={28} height={28} densities={[1, 2]} class="av" loading="eager" />}
      <span>Wassim Soltani</span>
    </a>
    <div class="end">
      <nav aria-label="Main" class="main">
        {NAV_MAIN.map((i) => (
          <a href={i.href} class:list={["item", { on: current === i.id }]} aria-current={here(i.id)}>{i.label}</a>
        ))}
      </nav>
      <button type="button" class="ask-btn" data-ask-open aria-controls="ask" aria-expanded="false"><span>Ask</span><kbd data-ask-key aria-hidden="true">⌘K</kbd></button>
      <ResumeLinks current={current === "resume"} />
      <button type="button" class="square menu-btn" popovertarget="menu" aria-label="Menu"><Icon name="menu" size={18} stroke={2} /></button>
    </div>
  </div>

  {/* The phone menu covers the page, so it repeats the header row with a close button. */}
  <div id="menu" popover class="sheet" data-menu>
    <div class="wrap row top">
      <a href="/" class="home" aria-label="Wassim Soltani, home">
        {showAvatar && <Image src={avatar} alt="" width={28} height={28} densities={[1, 2]} class="av" />}
        <span>Wassim Soltani</span>
      </a>
      <div class="end">
        <ResumeLinks current={current === "resume"} />
        <button type="button" class="square" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu"><Icon name="close" size={18} stroke={2} /></button>
      </div>
    </div>
    <nav aria-label="Menu" class="wrap big">
      {NAV_MENU.map((i) => <a href={i.href} aria-current={here(i.id)}>{i.label}</a>)}
    </nav>
    <div class="wrap elsewhere">
      {ELSEWHERE.map((l) => <a href={l.href} rel="me noopener" target="_blank">{l.label} ↗</a>)}
    </div>
  </div>
</header>

<style>
  .bar { height: 72px; flex-shrink: 0; border-bottom: 1px solid var(--line); display: flex; align-items: center; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .home { display: flex; align-items: center; gap: 12px; min-width: 0; text-decoration: none; font-weight: 600; font-size: 15px; white-space: nowrap; }
  .home span { overflow: hidden; text-overflow: ellipsis; }
  .av { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
  .end { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .main { display: flex; gap: 8px; font-size: 15px; margin-right: 12px; }
  .item { text-decoration: none; color: var(--muted); padding: 7px 12px; border-radius: 6px; transition: color var(--fast) ease, background var(--fast) ease; }
  .item:hover { color: var(--text); }
  .item.on { color: var(--text); background: var(--wine-raised); }

  .ask-btn { height: 40px; min-width: 132px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 8px 0 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; color: var(--muted); font-size: 15px; cursor: pointer; transition: border-color var(--fast) ease, color var(--fast) ease; }
  .ask-btn kbd { font: inherit; font-size: 12px; line-height: 20px; padding: 0 6px; color: var(--muted); border: 1px solid var(--line-strong); border-radius: 4px; }
  .ask-btn:hover { border-color: var(--line-strong); color: var(--text); }
  .ask-btn[aria-expanded="true"] { border-color: var(--cream); color: var(--cream); }

  .square { width: 44px; height: 44px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; padding: 0; background: none; border: 1px solid var(--line-strong); border-radius: 6px; color: var(--text); cursor: pointer; transition: background var(--fast) ease; }
  .square:hover { background: var(--surface); }
  .menu-btn { display: none; }

  .sheet { position: fixed; inset: 0; width: auto; height: auto; max-width: none; max-height: none; margin: 0; padding: 0 0 32px; border: 0; background: var(--ink); color: var(--text); overflow-y: auto; overscroll-behavior: contain; }
  .sheet:popover-open { display: flex; flex-direction: column; }
  .top { height: 64px; flex-shrink: 0; border-bottom: 1px solid var(--line); }
  .big { display: flex; flex-direction: column; padding-top: 16px; }
  .big a { text-decoration: none; font-size: 28px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; padding: 14px 0; border-bottom: 1px solid #262626; }
  .big a[aria-current] { color: var(--orchid); }
  .elsewhere { margin-top: auto; padding-top: 24px; display: flex; gap: 28px; font-size: 18px; }
  .elsewhere a { text-decoration: none; color: var(--muted); }
  .elsewhere a:hover { color: var(--orchid); }

  @media (max-width: 639px) {
    .bar { height: 64px; }
    .row { gap: 8px; }
    .home { gap: 8px; font-size: 14px; }
    .main { display: none; }
    .menu-btn { display: flex; }
    .ask-btn { min-width: 0; height: 44px; padding: 0 14px; }
    .ask-btn kbd { display: none; }
    :global(html:has(.sheet:popover-open)) { overflow: hidden; }
  }
  @media (min-width: 640px) { .sheet:popover-open { display: none; } }
</style>

<script>
  // Following a link closes the menu, so a link to this same page (#projects) lands on its spot.
  for (const menu of document.querySelectorAll<HTMLElement>("[data-menu]")) {
    menu.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) menu.hidePopover(); });
  }
</script>
