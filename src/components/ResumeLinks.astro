---
// The split Resume control: the page on one side, the PDF download on the other.
import Icon from "./Icon.astro";
import { RESUME } from "../data/nav";

interface Props { current?: boolean; }
const { current = false } = Astro.props;
---

<div class="resume">
  <a href={RESUME.page} class:list={["page", { on: current }]} aria-current={current ? "page" : undefined}>Resume</a>
  <a href={RESUME.pdf} class="pdf" aria-label="Download resume PDF" download>PDF<Icon name="download" size={14} stroke={2} /></a>
</div>

<style>
  .resume { display: flex; align-items: stretch; border: 1px solid var(--line-strong); border-radius: 6px; overflow: hidden; font-size: 15px; }
  a { display: flex; align-items: center; text-decoration: none; transition: color var(--fast) ease, background var(--fast) ease; }
  a:focus-visible { border-radius: 0; }
  .page { color: var(--text); padding: 7px 14px; }
  .page.on { background: var(--wine-raised); }
  .pdf { gap: 6px; color: var(--muted); padding: 7px 12px; border-left: 1px solid var(--line-strong); font-size: 13px; }
  a:hover { color: var(--orchid); }
  @media (max-width: 639px) {
    .resume { height: 44px; font-size: 14px; }
    .page { padding: 0 12px; }
    .pdf { gap: 4px; padding: 0 10px; }
  }
</style>
