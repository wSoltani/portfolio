---
interface Props { size: number; }
const { size } = Astro.props;
const id = `yh${size}-${Math.random().toString(36).slice(2, 7)}`;
---
<svg width={size} height={size} viewBox="0 0 1024 1024" aria-hidden="true" style="flex-shrink: 0">
  <defs><linearGradient id={id} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8b5cf6" /><stop offset="1" stop-color="#ec4899" /></linearGradient></defs>
  <circle cx="512" cy="512" r="424" fill="none" stroke={`url(#${id})`} stroke-width="56" />
  <circle cx="512" cy="512" r="360" fill="#18181b" />
  <g fill="#ffffff"><rect x="236" y="422" width="72" height="180" rx="36" /><rect x="356" y="352" width="72" height="320" rx="36" /><rect x="476" y="282" width="72" height="460" rx="36" /><rect x="596" y="352" width="72" height="320" rx="36" /><rect x="716" y="422" width="72" height="180" rx="36" /></g>
</svg>
