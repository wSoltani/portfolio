---
import Icon from "../Icon.astro";

export interface DNode { k: string; x: number; y: number; w: number; h: number; title: string; sub: string; icon: string; chips?: string[]; key?: boolean; }
export interface DLabel { x: number; y: number; text: string; small?: boolean; w?: number; center?: boolean; band?: boolean; }
export interface DExplain { k: string; title: string; body: string; }
interface Props {
  height: number;
  nodes: DNode[];
  /** Arrows, as raw SVG in the 1200-wide frame. */
  edges: string;
  labels?: DLabel[];
  rules?: { x: number; y: number; h: number }[];
  /** When given, nodes are buttons that pick which explanation shows. */
  explain?: DExplain[];
  initial?: string;
  /** Short text shown between nodes when the diagram is stacked on small screens. */
  stackNote?: string;
  /** Color every node's icon with the project accent. */
  accentIcons?: boolean;
}
const { height, nodes, edges, labels = [], rules = [], explain, initial, stackNote, accentIcons = false } = Astro.props;
const live = !!explain;
const first = initial ?? explain?.[0]?.k;
const start = nodes.find((n) => n.k === first);
---

<div class:list={["dia-wrap", { "accent-icons": accentIcons }]} data-dia>
  <div class="dia" style={`height:${height}px`}>
    <svg viewBox={`0 0 1200 ${height}`} width="1200" height={height} aria-hidden="true" set:html={edges} />
    {rules.map((r) => <div class="dia-rule" style={`left:${r.x}px;top:${r.y}px;height:${r.h}px`} />)}
    {labels.map((l) => (
      l.band
        ? <span class="dia-label band" style={`left:0;right:0;top:${l.y}px;text-align:center`}><span>{l.text}</span></span>
        : <span class:list={["dia-label", { sm: l.small }]} style={`left:${l.x}px;top:${l.y}px;${l.w ? `width:${l.w}px;` : ""}${l.center ? "text-align:center;white-space:normal;" : ""}`}>{l.text}</span>
    ))}
    {nodes.map((n) => {
      const Tag = live ? "button" : "div";
      return (
        <Tag type={live ? "button" : undefined} class:list={["node", { key: n.key, on: live && n.k === first }]} style={`left:${n.x}px;top:${n.y}px;width:${n.w}px;height:${n.h}px`} data-k={n.k} aria-pressed={live ? String(n.k === first) : undefined}>
          <span class="node-t"><span class="node-i"><Icon name={n.icon} /></span>{n.title}</span>
          <span class="node-s">{n.sub}</span>
          {n.chips && <span class="node-chips">{n.chips.map((c) => <span>{c}</span>)}</span>}
        </Tag>
      );
    })}
    {live && start && <span class="dia-ring" aria-hidden="true" style={`left:${start.x}px;top:${start.y}px;width:${start.w}px;height:${start.h}px`} />}
  </div>
  {stackNote && <p class="dia-note small">{stackNote}</p>}
</div>
{live && (
  <div class="panel explain" aria-live="polite" data-explain>
    {explain!.map((e) => (
      <div class:list={["explain-item", { on: e.k === first }]} data-k={e.k}>
        <span class="explain-t">{e.title}</span>
        <span class="panel-text explain-b">{e.body}</span>
      </div>
    ))}
  </div>
)}

<style>
  .dia-wrap { --z: 1; }
  .dia { zoom: var(--z); }
  .dia-label.band span { font-size: 13px; color: var(--muted); background: var(--ink); padding: 0 12px; }
  .dia-note { display: none; }
  .accent-icons :global(.node-i) { color: var(--p-accent); }
  /* One frame marks the chosen part and glides between parts; the part itself keeps a plain edge. */
  .dia-ring { position: absolute; border: 2px solid var(--p-accent); border-radius: 10px; pointer-events: none; }
  .dia:has(.dia-ring) .node.on { border: 1px solid var(--line); padding: 14px 18px; }
  /* Small screens: the nodes stack in reading order and the arrows go away. */
  @media (max-width: 899px) {
    .dia-wrap { --z: 1 !important; }
    .dia { height: auto !important; width: 100%; display: flex; flex-direction: column; gap: 12px; }
    .dia > svg, .dia-rule, .dia-label, .dia-ring { display: none; }
    .dia:has(.dia-ring) .node.on { border: 2px solid var(--p-accent); padding: 13px 17px; }
    .node { position: static; width: auto !important; height: auto !important; }
    .dia-note { display: block; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, T, EASE, reduced } from "../../scripts/motion";
  import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";
  gsap.registerPlugin(DrawSVGPlugin);

  const fit = () => {
    for (const w of document.querySelectorAll<HTMLElement>("[data-dia]")) w.style.setProperty("--z", String(Math.min(1, w.clientWidth / 1200)));
  };
  fit();
  addEventListener("resize", fit);

  for (const w of document.querySelectorAll<HTMLElement>("[data-dia]")) {
    const dia = w.querySelector<HTMLElement>(".dia")!;
    const ring = dia.querySelector<HTMLElement>(".dia-ring");

    // When the diagram arrives, the parts appear in reading order and the arrows draw themselves.
    if (!reduced()) {
      const lines = dia.querySelectorAll("svg g[stroke] path");
      const heads = dia.querySelectorAll("svg g[fill] path, svg rect");
      const parts = dia.querySelectorAll(".node, .dia-label, .dia-rule");
      gsap.set(parts, { opacity: 0, y: 8 });
      gsap.set(heads, { autoAlpha: 0 });
      gsap.set(lines, { drawSVG: "0%" });
      if (ring) gsap.set(ring, { autoAlpha: 0 });
      ScrollTrigger.create({
        trigger: dia, start: "top 80%", once: true,
        onEnter: () => {
          gsap.timeline({ defaults: { ease: EASE.enter } })
            .to(parts, { opacity: 1, y: 0, duration: T.slow, stagger: T.stagger, clearProps: "transform" })
            .to(lines, { drawSVG: "100%", duration: T.slow, ease: EASE.move, stagger: T.stagger }, 0.15)
            .to(heads, { autoAlpha: 1, duration: T.base }, ">-0.2")
            .to(ring ?? [], { autoAlpha: 1, duration: T.base }, "<");
        },
      });
    }

    const panel = w.nextElementSibling?.matches("[data-explain]") ? (w.nextElementSibling as HTMLElement) : null;
    if (!panel) continue;
    w.addEventListener("click", (e) => {
      const n = (e.target as HTMLElement).closest<HTMLElement>("button.node");
      if (!n || n.classList.contains("on")) return;
      w.querySelectorAll<HTMLElement>(".node").forEach((x) => { x.classList.toggle("on", x === n); x.setAttribute("aria-pressed", String(x === n)); });
      panel.querySelectorAll<HTMLElement>(".explain-item").forEach((x) => x.classList.toggle("on", x.dataset.k === n.dataset.k));
      if (ring) {
        const to = { left: n.style.left, top: n.style.top, width: n.style.width, height: n.style.height };
        reduced() ? gsap.set(ring, to) : gsap.to(ring, { ...to, duration: T.slow, ease: EASE.move, overwrite: true });
      }
      const item = panel.querySelector<HTMLElement>(".explain-item.on");
      if (item && !reduced()) gsap.from(item.children, { autoAlpha: 0, y: 8, duration: T.base, ease: EASE.enter, stagger: T.stagger });
    });
  }
</script>
