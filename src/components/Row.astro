---
// One row of a home page list: a link with a thin Flowlines strip seeded by its slug,
// a name, a line and a small line of facts. The Work list and Other projects share it.
import Flow from "./Flow.astro";

interface Props { href: string; seed: string; name: string; line: string; meta: string; }
const { href, seed, name, line, meta } = Astro.props;
---

<a href={href} class="row">
  <Flow width={24} height={160} seed={seed} period={12} class="strip" />
  <span class="text">
    <span class="name">{name}</span>
    <span class="line">{line}</span>
    <span class="meta">{meta}</span>
  </span>
  <svg class="arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
</a>

<style>
  .row {
    display: grid; grid-template-columns: 24px minmax(0, 1fr) 24px; gap: 20px; align-items: center; padding-right: 18px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; text-decoration: none; color: var(--text);
    transition: background var(--fast) ease, border-color var(--fast) ease;
  }
  .row:hover { background: var(--wine); border-color: var(--wine-line); color: var(--text); }
  .row :global(.strip) { display: block; width: 24px; height: 100%; min-height: 72px; align-self: stretch; contain: size; }
  .text { display: flex; flex-direction: column; gap: 4px; padding: 14px 0; }
  .name { font-size: 17px; font-weight: 600; }
  .line { font-size: 14px; line-height: 1.5; color: #c9c9c9; }
  /* Lines are written to fit three lines on a wide screen; the clamp only guards against a
     longer one there. Narrower screens show the whole line. */
  @media (min-width: 1024px) { .line { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; } }
  .meta { font-size: 13px; color: var(--subtle); }
  .arrow { color: var(--subtle); transition: transform var(--fast) ease, color var(--fast) ease; }
  .row:hover .arrow { color: var(--text); transform: translateX(3px); }
  @media (max-width: 767px) {
    .row { grid-template-columns: 16px minmax(0, 1fr) 20px; gap: 14px; padding-right: 12px; }
    .row :global(.strip) { width: 16px; }
  }
</style>
