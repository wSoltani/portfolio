---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";
import fontUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Current nav item, if the page is one. */
  nav?: "projects" | "map" | "contact";
  noindex?: boolean;
  /** Home: no footer gap, and no small avatar in the header (the big one is on the page). */
  flushFooter?: boolean;
  /** Structured data for search engines (schema.org), added to the page as JSON-LD. */
  schema?: Record<string, unknown>[];
  imageAlt?: string;
}

const { title, description = SITE.description, image = "/og/default.png", nav, noindex = false, flushFooter = false, schema = [], imageAlt } = Astro.props;
const person = { "@type": "Person", "@id": `${SITE.url}/#me`, name: SITE.name, url: SITE.url, jobTitle: "Software engineer", image: `${SITE.url}/web-app-manifest-512x512.png`, sameAs: [SITE.github, SITE.linkedin] };
const graph = { "@context": "https://schema.org", "@graph": [person, ...schema] };
const fullTitle = title ? `${title} – ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? (title ? `${title}, on wsoltani.com` : "Wassim Soltani, software engineer")} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content={SITE.name} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Motion runs only without reduced motion. If the motion script never arrives, content shows anyway.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        setTimeout(() => document.documentElement.classList.add("motion-ready"), 2500);
      }
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analyticsId}`}></script>
    <script is:inline define:vars={{ id: SITE.analyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", id);
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <Header current={nav} avatar={!flushFooter} />
    <main id="main">
      <slot />
    </main>
    <Footer flush={flushFooter} />
  </body>
</html>

<script>
  import "../scripts/motion";
</script>

<style>
  .skip:focus { position: fixed; left: 16px; top: 12px; width: auto; height: auto; clip: auto; margin: 0; padding: 8px 12px; background: var(--raised); color: var(--text); z-index: 100; border-radius: 6px; }
</style>
