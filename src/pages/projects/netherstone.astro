---
import { Image } from "astro:assets";
import Showcase from "../../layouts/Showcase.astro";
import Icon from "../../components/Icon.astro";
import Tour from "../../components/showcase/Tour.astro";
import Timeline from "../../components/showcase/Timeline.astro";
import Diagram from "../../components/showcase/Diagram.astro";
import Tabs from "../../components/showcase/Tabs.astro";
import Facts from "../../components/showcase/Facts.astro";
import { bySlug, live } from "../../data/projects";
import { nsTour } from "../../data/tours";
import hero from "../../assets/netherstone/hero.png";
import lockup from "../../assets/netherstone/lockup-dark.svg";
import Vault from "../../assets/netherstone/Vault.webp";
import Editor from "../../assets/netherstone/Editor.webp";
import Links from "../../assets/netherstone/Links.webp";
import Search from "../../assets/netherstone/Search.webp";
import Files from "../../assets/netherstone/Files.webp";
import Research from "../../assets/netherstone/Research.webp";
import Sync from "../../assets/netherstone/Sync.webp";
import History from "../../assets/netherstone/History.webp";
import Overview from "../../assets/netherstone/Overview.webp";
import Import from "../../assets/netherstone/Import.webp";
import Export from "../../assets/netherstone/Export.webp";
import Themes from "../../assets/netherstone/Themes.webp";
import Old1 from "../../assets/netherstone/Old1.webp";
import Old2 from "../../assets/netherstone/Old2.webp";
import Old3 from "../../assets/netherstone/Old3.webp";
import Old4 from "../../assets/netherstone/Old4.webp";
import Lightbox from "../../components/showcase/Lightbox.astro";
import "@fontsource/geist/600.css";
import "@fontsource/newsreader/400.css";

const p = bySlug("netherstone");
const L = await live(p);
const win = L.assets.find((a) => a.name.endsWith("_x64-setup.exe"))?.url ?? "https://netherstone.app/download";
const steps = nsTour({ Vault, Editor, Links, Search, Files, Research, Sync, History, Overview, Import, Export, Themes });
const repo = `https://github.com/${p.repo}`;

const miles = [
  { d: "Apr 16, 2026", t: "First project files", body: "Netherstone started on April 16 with a plain Markdown editor. Two days later Plate replaced it, and the rest of the month went into making it fast, along with the browser panel, Excalidraw drawings and recent shards in the sidebar." },
  { d: "End of May", t: "Paused", body: "May brought @ mentions in place of wikilinks, and a canvas mode for drawing. Large shards were still slow to open, because the rich editor draws every block. A workaround that loaded shards a little at a time stayed janky, so the project went on hold." },
  { d: "June", t: "Plate's update", body: "Plate 53.0.7 came out on June 3 and made large documents load about 2.7 times faster." },
  { d: "September", t: "Picked back up", body: "Back on it, Netherstone moved to Plate 53 and split each shard into groups of 100 blocks, so the ones off screen aren't drawn. Git sync, attachments and drawings saved in the vault came in the same stretch." },
  { d: "Oct 4, 2026", t: "Public beta", body: "Netherstone 0.1.0 beta 1 went public on October 4, with first-run onboarding and updates from GitHub releases. Beta 2 followed two days later with folders in the sidebar." },
  { d: "Oct 7, 2026", t: "Export and themes", body: "0.2 added export to PDF, Word and web pages, and three new themes: Tyrant, Bloodline and Citadel. Its second beta let you drag shards into folders and turned the table of contents into an Outline." },
  { d: "Oct 16, 2026", t: "A new layout", body: "0.3 rebuilt the layout around a rail for Editor, Tags and Canvas, a sidebar with Pinned and Recent shards, and a right sidebar with Outline, Links and Details. The whole interface can be zoomed too." },
  { d: "Oct 21, 2026", t: "Vault health", body: "0.4 was about the health of a vault. Every shard and drawing keeps its earlier versions, Overview shows a writing calendar, charts from tables and broken links, and Import brings in Word, PDF, web pages and CSV. Beta 2 followed on October 24." },
  { d: "Oct 25, 2026", t: "Gallery and history", body: "0.5 added a Gallery of every attachment in a vault. History now saves a version every ten minutes while you write, shows which device made each one, and can free up the space old attachment versions take. Big files copy in without holding up saves." },
];

const edges = `<g stroke="#4a4a4a" stroke-width="1.5" fill="none"><path d="M220 196 H 262"/><path d="M220 46 H 355 V 142"/><path d="M440 196 H 482"/><path d="M640 120 V 80"/><path d="M640 272 V 312"/></g><g fill="#4a4a4a"><path d="M262 191 L 270 196 L 262 201 Z"/><path d="M350 142 L 355 150 L 360 142 Z"/><path d="M482 191 L 490 196 L 482 201 Z"/><path d="M635 80 L 640 72 L 645 80 Z"/><path d="M635 312 L 640 320 L 645 312 Z"/></g><g stroke="#8fd1be" stroke-width="2" fill="none"><path d="M798 196 H 832"/><path d="M1008 196 H 1032"/></g><g fill="#8fd1be"><path d="M798 191 L 790 196 L 798 201 Z"/><path d="M832 191 L 840 196 L 832 201 Z"/><path d="M1008 191 L 1000 196 L 1008 201 Z"/><path d="M1032 191 L 1040 196 L 1032 201 Z"/></g>`;
const nodes = [
  { k: "draw", x: 0, y: 0, w: 220, h: 92, title: "Drawings", sub: "Excalidraw", icon: "draw" },
  { k: "edit", x: 0, y: 150, w: 220, h: 92, title: "Editor", sub: "Plate", icon: "pen" },
  { k: "web", x: 0, y: 300, w: 220, h: 92, title: "Browser panel", sub: "Beside the editor", icon: "globe" },
  { k: "save", x: 270, y: 150, w: 170, h: 92, title: "Saving", sub: "Rust", icon: "save" },
  { k: "index", x: 490, y: 0, w: 300, h: 72, title: "Index", sub: "SQLite, kept outside the vault", icon: "search" },
  { k: "vault", x: 490, y: 120, w: 300, h: 152, title: "Vault", sub: "A folder you choose", icon: "folder", chips: ["Shards", "Drawings", "Attachments"] },
  { k: "export", x: 490, y: 320, w: 300, h: 72, title: "Export", sub: "PDF, Word, web page", icon: "fileDown" },
  { k: "sync", x: 840, y: 150, w: 160, h: 92, title: "Sync", sub: "Git, out of sight", icon: "git", key: true },
  { k: "gh", x: 1040, y: 150, w: 160, h: 92, title: "Your GitHub", sub: "A private repo", icon: "cloud" },
];
const docs = `${repo}/blob/main/docs`;
const tabs = ["Name", "Identity", "Audience", "Pricing", "Launch"];
const facts = [
  { value: String(L.releases ?? 8), label: "Releases" },
  { value: "3", label: "Platforms" },
  { value: (L.version ?? "0.5").split(".").slice(0, 2).join("."), label: "Latest version, beta" },
  { value: "GPL-3.0", label: "Open source" },
];
---

<Showcase slug="netherstone" title="Netherstone" description="A desktop app for your knowledge: documents, drawings, files and more, in a folder on your computer and synced across your devices for free.">
  <section slot="hero" class="sc-hero">
    <div class="sc-hero-card">
      <div class="sc-hero-text">
        <h1 class="sr-only">Netherstone</h1>
        <img src={lockup.src} alt="Netherstone" width="289" height="64" style="height: 64px; width: auto; align-self: flex-start" />
        <p class="sc-hero-title">Your knowledge, set in stone.</p>
        <p class="sc-hero-sub">A desktop app for your knowledge: documents, drawings, files and more. Everything lives in a folder on your computer and syncs across your devices for free.</p>
        <div class="sc-actions">
          <a class="sc-btn" href={win}><Icon name="download" />Windows</a>
          <a class="sc-btn" href="https://netherstone.app/download#platforms"><Icon name="download" />macOS</a>
          <a class="sc-btn" href="https://netherstone.app/download#platforms"><Icon name="download" />Linux</a>
        </div>
        <div class="sc-actions">
          <a class="sc-btn outline" href="https://netherstone.app">netherstone.app ↗</a>
          <a class="sc-round" href={repo} aria-label="Source code on GitHub"><Icon name="github" size={20} /></a>
          <a class="sc-round" href="https://www.reddit.com/r/Netherstone/" aria-label="r/Netherstone on Reddit"><Icon name="reddit" size={20} /></a>
        </div>
        <p class="sc-facts parts"><span>{L.versionLabel}</span><span>{L.dateLabel}</span><span>Free and open source (GPL-3.0)</span></p>
      </div>
      <Image src={hero} alt="Netherstone editor with a shard open" widths={[480, 800, 1400]} sizes="(min-width: 1280px) 700px, (min-width: 1024px) 45vw, calc(100vw - 48px)" class="sc-shot" priority />
    </div>
  </section>

  <section class="sc-sec" data-reveal>
    <h2 class="h2">Tour</h2>
    <Tour project="Netherstone" steps={steps} />
  </section>

  <section class="sc-sec" data-reveal>
    <h2 class="h2">Concept</h2>
    <Timeline miles={miles} />
    <div class="concept-more">
      <div class="quote">
        <q>I kept Markdown as the base and rebuilt everything around a rich editor.</q>
        <a class="accent-link" href="https://netherstone.app/why">Why I built Netherstone ↗</a>
      </div>
      <Lightbox images={[Old1, Old2, Old3, Old4]} alt="An early build of Netherstone" caption="Early builds, April to May" />
    </div>
  </section>

  <section class="sc-sec" data-reveal>
    <h2 class="h2">How it's built</h2>
    <Diagram height={392} nodes={nodes} edges={edges} />
    <div class="panel explain">
      <span class="explain-t">Git does the work, out of sight.</span>
      <span class="panel-text explain-b">Sync was planned this way from the start. Git keeps the full history, but its data lives in the app's own folder, so your vault stays a clean folder of your files, and the app only says things like “Synced” and “Choose which version to keep”. You sign in on GitHub's own page through the Netherstone GitHub App, so the app never sees your password and carries no secret of its own. The sign-in is kept in your system's keychain: Keychain on macOS, Credential Manager on Windows, or the Linux keyring. On a Linux desktop without one, it goes in a file only your account can read, outside your vault.</span>
    </div>
    <div class="built-foot">
      <div class="chips">{p.tech.map((t) => <a class="pill" href={`/map?t=${encodeURIComponent(t)}`}>{t}</a>)}</div>
      <div class="doc-links">
        <a href={`${docs}/ARCHITECTURE.md`}>Architecture ↗</a>
        <a href={`${docs}/ATTACHMENTS_ARCHITECTURE.md`}>Attachments ↗</a>
        <a href={`${docs}/GIT_SYNC_ARCHITECTURE.md`}>Git sync ↗</a>
      </div>
    </div>
  </section>

  <section class="sc-sec" data-reveal>
    <h2 class="h2">How it's shaped</h2>
    <Tabs names={tabs} initial="Identity" label="How Netherstone is shaped">
      <div class="tabpanel" data-tab="Name" hidden>
        <div class="panel tab-card">
          <img src={lockup.src} alt="Netherstone" width="217" height="48" loading="lazy" style="height: 48px; width: auto; align-self: flex-start" />
          <div class="kv"><span>Vault</span><span>A folder on your computer</span></div>
          <div class="kv"><span>Shard</span><span>A document saved in it</span></div>
        </div>
        <p class="prose">Netherstone is a made-up name for a stone that sounds like it comes from deep underground. The rest of the app's words follow from it, so documents are shards and the folder that holds them is a vault.</p>
      </div>
      <div class="tabpanel" data-tab="Identity">
        <div class="panel tab-card" style="gap: 28px">
          <img src={lockup.src} alt="Netherstone" width="217" height="48" loading="lazy" style="height: 48px; width: auto; align-self: flex-start" />
          <div style="display: flex; flex-direction: column; gap: 10px">
            <div class="swatch"><i style="background:#141516" /><i style="background:#2A2C2E" /><i style="background:#8A8780" /><i style="background:#EEEBE5" /><i style="background:#4FA38E" /></div>
            <span style="font-size: 14px; color: var(--p-accent)">Basalt</span>
          </div>
          <div class="dropped">
            <span class="label" style="color: var(--subtle)">Also explored, then dropped</span>
            <span class="drop"><span class="mini"><i style="background:#151112" /><i style="background:#2E2829" /><i style="background:#9A918C" /><i style="background:#F3EEE8" /><i style="background:#E0663A" /></span><span class="label" style="color: var(--subtle)">Ember</span></span>
            <span class="drop"><span class="mini"><i style="background:#0E1320" /><i style="background:#222A3A" /><i style="background:#8B93A5" /><i style="background:#F2F4F8" /><i style="background:#3D6FE3" /></span><span class="label" style="color: var(--subtle)">Lapis</span></span>
          </div>
        </div>
        <div class="prose" style="gap: 16px">
          <span class="h3" style="font-size: 24px; letter-spacing: -0.015em; color: var(--text)">Your knowledge, set in stone.</span>
          <span>Netherstone holds everything you work on, from ideas and research to brand guides and the concepts you set aside, and it's made to keep them for good.</span>
          <span class="type-pair"><span class="geist">Geist</span><span class="newsreader">Newsreader</span></span>
        </div>
      </div>
      <div class="tabpanel" data-tab="Audience" hidden>
        <div class="panel tab-card">
          <span class="big-quote">“It doesn't target one kind of user. Anyone can use it, and everyone will find value in it.”</span>
          <span class="small" style="color: var(--subtle)">From “Why I built Netherstone”</span>
        </div>
        <p class="prose">Netherstone is made for anyone who keeps documents, research or ideas. Sync runs on Git, but the app never mentions it, so nobody has to learn Git to use it.</p>
      </div>
      <div class="tabpanel" data-tab="Pricing" hidden>
        <div class="panel tab-card">
          <div class="price"><b>$0</b><span>the app and sync</span></div>
          {[["Managed sync", "your own GitHub, free"], ["Built-in AI", "your own key, free"], ["Publishing", "export to HTML and host it, free"], ["Live collaboration", "works when everyone is online, free"]].map(([a, b]) => (
            <div class="kv2 even"><span style="font-size: 15px">{a}</span><span style="font-size: 15px; color: var(--p-soft)">or {b}</span></div>
          ))}
        </div>
        <p class="prose">The app and sync are free, and stay free. Any paid service added later comes with a free way to do the same thing yourself. Paid services are there to keep Netherstone independent and open source.</p>
      </div>
      <div class="tabpanel" data-tab="Launch" hidden>
        <div class="panel tab-card">
          <span class="label" style="color: var(--subtle)">Public beta since Oct 4, 2026</span>
          <div class="kv2"><span>Windows</span><span>Tested most</span></div>
          <div class="kv2"><span>macOS and Linux</span><span>Same release as Windows</span></div>
        </div>
        <p class="prose">Netherstone launched as a public beta on Oct 4, 2026. On its website, people vote on the roadmap to decide what comes next. The changelog updates itself with every release, and an occasional newsletter covers what's new.</p>
      </div>
    </Tabs>
  </section>

  <Facts slot="after" items={facts} />
</Showcase>

<style>
  .dropped { display: flex; align-items: center; gap: 12px 20px; flex-wrap: wrap; border-top: 1px solid var(--p-sep); padding-top: 16px; }
  .drop { display: flex; align-items: center; gap: 10px; }
  .kv2.even { grid-template-columns: 1fr 1fr; }
  .type-pair { display: flex; gap: 32px; align-items: baseline; color: var(--text); font-size: 22px; }
  .geist { font-family: "Geist", var(--font); font-weight: 600; }
  .newsreader { font-family: "Newsreader", Georgia, serif; }
</style>
