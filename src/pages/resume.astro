---
import Base from "../layouts/Base.astro";
import { HEADLINE, LOCATION, SUMMARY, JOBS, EDU, SKILLS, LANG, RESUME_PROJECTS } from "../data/resume";
import { RESUME } from "../data/nav";
import { SITE } from "../data/site";

const contact = [
  { label: SITE.email, href: `mailto:${SITE.email}` },
  { label: "wsoltani.com", href: SITE.url },
  { label: "linkedin.com/in/wsoltani", href: SITE.linkedin },
  { label: "github.com/wSoltani", href: SITE.github },
];
---

<Base title="Resume" description="Experience, projects, education and skills." nav="resume" image="/og/resume.png">
  <div class="wrap resume">
    <header class="top">
      <div class="who">
        <h1 class="h1" data-title>Resume</h1>
        <p class="split sub"><span>Wassim Soltani</span><span>{HEADLINE}</span><span>{LOCATION}</span></p>
        <p class="split contact">{contact.map((c) => <span><a href={c.href} class="link">{c.label}</a></span>)}</p>
      </div>
    </header>
    <p class="summary">{SUMMARY}</p>
    <a href={RESUME.pdf} class="btn btn-outline pdf" download>Download PDF</a>

    <section class="sec" data-reveal>
      <h2 class="h3">Professional Experience</h2>
      {JOBS.map((j) => (
        <div class="row">
          <span class="when">{j.when}</span>
          <div class="what job">
            <span class="title">{j.role}{j.org && <span class="org">, {j.org}</span>}</span>
            {j.intro && <p class="intro">{j.intro}</p>}
            {j.lead && <ul>{j.lead.map((l) => <li>{l}</li>)}</ul>}
            {j.groups.map((g) => (
              <div class="group">
                <h3 class="name"><a href={`/work/${g.slug}`} class="link">{g.name}</a></h3>
                <p class="context">{g.context}</p>
                <ul>{g.items.map((l) => <li>{l}</li>)}</ul>
                {g.stack && <p class="stack">{g.stack.join(", ")}</p>}
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="sec" data-reveal>
      <h2 class="h3">Projects</h2>
      {RESUME_PROJECTS.map((p) => (
        <div class="row">
          <span class="when">{p.when}</span>
          <div class="what">
            <span class="title"><a href={`/projects/${p.slug}`} class="link">{p.name}</a> <span class="org gap">{p.category}</span></span>
            <p class="p">{p.line}</p>
            <p class="split facts">{p.facts.map((f) => <span>{f}</span>)}</p>
          </div>
        </div>
      ))}
      <p class="older">Older projects are in the <a href="/archive" class="link">archive</a></p>
    </section>

    <section class="sec" data-reveal>
      <h2 class="h3">Education</h2>
      {EDU.map((e) => (
        <div class="row">
          <span class="when">{e.w}</span>
          <div class="what" style="gap: 6px">
            <span class="title">{e.t} <span class="org gap">{e.o}</span></span>
            {e.d && <p class="p">{e.d}</p>}
          </div>
        </div>
      ))}
    </section>

    <section class="sec" data-reveal>
      <h2 class="h3">Skills</h2>
      <div class="skills">{SKILLS.map(([a, b]) => <div class="skill"><h3 class="name">{a}</h3><p class="p">{b.join(", ")}</p></div>)}</div>
    </section>

    <section class="sec" data-reveal>
      <h2 class="h3">Languages</h2>
      <p class="split langs">{LANG.map(([a, b]) => <span><strong>{a}</strong> {b}</span>)}</p>
    </section>
  </div>
</Base>

<style>
  .top { padding-top: 96px; }
  .who { display: flex; flex-direction: column; gap: 12px; }
  /* Items split by a thin rule, never a typed separator. Every item has the rule in front; the row is
     shifted left by one rule and that strip is clipped off, so a wrapped line never starts with one. */
  .split { --pad: 12px; display: flex; flex-wrap: wrap; row-gap: 6px; margin-left: calc(-1 * (var(--pad) + 1px)); clip-path: inset(-4px -4px -4px calc(var(--pad) + 1px)); }
  .split > span { border-left: 1px solid var(--line-strong); padding: 0 var(--pad); }
  .sub { font-size: 18px; color: var(--body); }
  .contact { font-size: 15px; color: var(--muted); }
  .summary { margin-top: 32px; max-width: 960px; font-size: 18px; line-height: 1.6; color: var(--body); }
  .sec { padding-top: 64px; display: flex; flex-direction: column; }
  .pdf { margin-top: 24px; }
  .pdf + .sec { padding-top: 48px; }
  .sec .h3 { margin-bottom: 8px; }
  .row { display: grid; grid-template-columns: 200px 1fr; gap: 32px; padding: 24px 0; border-top: 1px solid #262626; }
  /* Skills in three columns, each a bold label over a comma list. */
  .skills { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 48px; padding-top: 24px; border-top: 1px solid #262626; }
  .skill { display: flex; flex-direction: column; gap: 6px; }
  .langs { padding-top: 24px; border-top: 1px solid #262626; font-size: 16px; color: var(--body); }
  .langs strong { font-weight: 600; color: var(--text); margin-right: 6px; }
  .when { font-size: 14px; color: var(--subtle); padding-top: 3px; }
  .what { display: flex; flex-direction: column; gap: 8px; }
  .job { gap: 16px; }
  .title { font-size: 18px; font-weight: 600; }
  .org { color: var(--muted); font-weight: 400; }
  .gap { margin-left: 0.5em; }
  .intro { margin-top: -8px; font-size: 16px; color: var(--muted); }
  .group { display: flex; flex-direction: column; gap: 4px; }
  .name { font-size: 16px; font-weight: 600; color: var(--text); }
  .context { font-size: 15px; color: var(--muted); }
  ul { margin: 0; padding-left: 18px; font-size: 16px; line-height: 1.6; color: var(--body); }
  li { margin: 0 0 4px; }
  .p { font-size: 16px; line-height: 1.6; color: var(--body); }
  .stack { padding-left: 18px; font-size: 14px; color: var(--subtle); }
  .facts { --pad: 10px; row-gap: 2px; font-size: 14px; color: var(--subtle); }
  .older { margin-top: 16px; font-size: 15px; color: var(--muted); }
  .link { text-decoration-color: #4a4a4a; text-underline-offset: 3px; }
  @media (max-width: 767px) {
    .row { grid-template-columns: 1fr; gap: 6px; }
    .skills { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
