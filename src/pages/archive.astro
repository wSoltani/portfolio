---
import Base from "../layouts/Base.astro";

import { ARCHIVE } from "../data/archive";
---

<Base title="Archive" description="Older projects I've stopped working on. They stay here as a record." image="/og/archive.png">
  <div class="wrap">
    <header class="top">
      <h1 class="h1" data-title>Archive</h1>
      <p class="lead">Older projects I've stopped working on. They stay here as a record.</p>
    </header>
    <div class="table" data-reveal role="table" aria-label="Archived projects">
      <div class="row head" role="row"><span role="columnheader">Projects</span><span role="columnheader"><span class="sr-only">About</span></span><span role="columnheader">Kind</span><span role="columnheader">When</span><span role="columnheader"><span class="sr-only">Links</span></span></div>
      {ARCHIVE.map((p) => (
        <div class="row" role="row">
          <span role="cell" class="name">{p.name}</span>
          <span role="cell" class="desc">{p.line}</span>
          <span role="cell" class="meta">{p.kind}</span>
          <span role="cell" class="meta">{p.when}</span>
          <span role="cell" class="links">{p.links.map(([t, h]) => <a href={h} class="ext">{t} ↗</a>)}</span>
        </div>
      ))}
    </div>
    <p class="dev">I used to write on <a href="https://dev.to/wsoltani" class="ext">DEV ↗</a></p>
  </div>
</Base>

<style>
  .top { padding-top: 96px; display: flex; flex-direction: column; gap: 16px; }
  .lead { max-width: 64ch; }
  .table { padding-top: 64px; display: flex; flex-direction: column; }
  .row { display: grid; grid-template-columns: 240px 1fr 150px 120px 200px; gap: 24px; align-items: baseline; padding: 20px 0; border-top: 1px solid #262626; }
  .row.head { border-top: 0; padding: 0 0 12px; font-size: 13px; color: var(--subtle); }
  .name { font-size: 17px; font-weight: 600; }
  .desc { font-size: 15px; line-height: 1.55; color: #c9c9c9; }
  .meta { font-size: 14px; color: var(--muted); }
  .links { display: flex; gap: 14px; font-size: 14px; justify-content: flex-end; flex-wrap: wrap; }
  .ext { color: var(--body); text-decoration: underline; text-decoration-color: #4a4a4a; text-underline-offset: 4px; }
  .ext:hover { color: var(--orchid); }
  .dev { padding-top: 48px; font-size: 15px; color: var(--muted); }
  @media (max-width: 1023px) {
    .row { grid-template-columns: 1fr auto; gap: 6px 16px; }
    .row.head { display: none; }
    .name { grid-column: 1; }
    .meta:nth-of-type(4) { grid-column: 2; grid-row: 1; }
    .desc { grid-column: 1 / -1; }
    .meta:nth-of-type(3) { grid-column: 1 / -1; font-size: 13px; color: var(--subtle); }
    .links { grid-column: 1 / -1; justify-content: flex-start; }
    .links:empty { display: none; }
  }
</style>
