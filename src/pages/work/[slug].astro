---
// A Work entry's own page: its header line, a Flowlines band seeded by its slug, and the
// sections written in work/<slug>.md.
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Flow from "../../components/Flow.astro";
import Dots from "../../components/Dots.astro";
import { WORK, headerParts, type WorkEntry } from "../../data/work";

export const getStaticPaths = (() => WORK.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: WorkEntry };
const { Content } = await render(entry);
const w = entry.data;
---

<Base title={w.name} description={w.line} image={`/og/work-${entry.id}.png`} nav="work">
  <article class="wrap page">
    <a href="/#work" class="back">← Work</a>
    <header class="head">
      <h1 class="h1" data-title>{w.name}</h1>
      <p class="meta"><Dots parts={headerParts(w)} /></p>
    </header>
    <Flow width={1200} height={120} seed={entry.id} settle class="band" />
    <div class="body" data-reveal><Content /></div>
  </article>
</Base>

<style>
  .page { padding-top: 72px; display: flex; flex-direction: column; gap: 32px; }
  .back { align-self: flex-start; font-size: 15px; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--orchid); }
  .head { display: flex; flex-direction: column; gap: 12px; }
  .meta { font-size: 18px; color: var(--muted); }
  .page :global(.band) { display: block; width: 100%; height: 120px; border-radius: 12px; }
  .body { max-width: 68ch; display: flex; flex-direction: column; gap: 16px; }
  .body :global(h2) { font-size: 22px; font-weight: 600; letter-spacing: -0.015em; margin: 24px 0 0; }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(p), .body :global(li) { font-size: 18px; line-height: 1.6; color: var(--body); }
  .body :global(ul) { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 8px; }
  @media (max-width: 767px) {
    .page { padding-top: 48px; gap: 24px; }
    .page :global(.band) { height: 80px; }
    .body :global(p), .body :global(li) { font-size: 17px; }
  }
</style>
