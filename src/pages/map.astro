---
// The Map: every project as a peak, my own on the left and work in one area per employer.
// Picking a peak lights its rings in its own color, links every project that shares a
// technology with it, and fills the card with what it's built with and who shares what.
import Base from "../layouts/Base.astro";
import MapTerrain from "../components/MapTerrain.astro";
import { WIDE, NARROW, mapData } from "../lib/terrain";
import { PROJECTS } from "../data/projects";

const data = mapData();
---

<Base title="Map" description="Every project on one map: what each is built with, and the technology they share." nav="map" image="/og/map.png">
  <div class="wrap">
    <header class="top">
      <h1 class="h1" data-title>Map</h1>
      <p class="lead">Every project as a peak. Pick one to see what it's built with, and which projects share it.</p>
    </header>

    <div class="row" data-map data-first={PROJECTS[0]?.slug}>
      <div class="maps" data-reveal>
        <MapTerrain layout={WIDE} interactive class="wide" />
        <MapTerrain layout={NARROW} interactive defs={false} class="narrow" />
      </div>

      <aside class="card" data-card aria-live="polite" hidden>
        <button type="button" class="grip" data-close aria-label="Close"></button>
        <div class="head">
          <span class="swatch" data-swatch></span>
          <h2 class="name" data-name></h2>
          <a class="link open open-top" data-open href="/"></a>
        </div>
        <p class="meta" data-meta></p>
        <div class="group" data-built>
          <p class="label">Built with</p>
          <div class="chips" data-chips></div>
        </div>
        <div class="group shared" data-shared-group>
          <p class="label">Shared with</p>
          <ul class="list" data-shared></ul>
        </div>
        <p class="summary" data-summary></p>
        <a class="link open open-end" data-open href="/"></a>
      </aside>
    </div>
  </div>
</Base>

<script is:inline type="application/json" id="map-data" set:html={JSON.stringify(data)} />

<style>
  .top { padding-top: 96px; display: flex; flex-direction: column; gap: 16px; }
  .lead { max-width: 62ch; }
  .row { margin-top: 48px; display: grid; gap: 40px; align-items: start; }
  .maps :global(.terrain) { width: 100%; height: auto; }
  .maps :global(.narrow) { display: none; }
  /* Wide: the map and the card side by side, reaching past the page's column on each side. */
  @media (min-width: 1100px) {
    .row { grid-template-columns: minmax(0, 900px) minmax(260px, 1fr); gap: 72px; }
  }
  @media (min-width: 1360px) {
    .row { margin-inline: -40px; }
  }

  .card { display: flex; flex-direction: column; gap: 22px; }
  .card[hidden] { display: none; }
  .grip { display: none; }
  .head { display: flex; align-items: center; gap: 10px; }
  .swatch { width: 10px; height: 10px; border-radius: 50%; background: var(--acc, var(--cream)); flex-shrink: 0; }
  .name { margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; color: var(--cream); }
  .meta { margin: -16px 0 0; font-size: 14px; color: var(--muted); }
  .group { display: flex; flex-direction: column; gap: 10px; }
  .group[hidden] { display: none; }
  .label { margin: 0; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--subtle); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips :global(button) { font: inherit; font-size: 13px; line-height: 26px; padding: 0 10px; background: none; border: 1px solid var(--line); border-radius: 13px; color: var(--body); white-space: nowrap; cursor: default; }
  .chips :global(button.hot) { border-color: var(--acc); color: var(--cream); }
  .list { list-style: none; margin: 0 -10px; padding: 0; }
  .list :global(button) { display: grid; grid-template-columns: 92px 1fr; gap: 12px; width: 100%; padding: 8px 10px; background: none; border: 0; border-radius: 6px; font: inherit; font-size: 13px; line-height: 1.5; text-align: left; color: var(--subtle); cursor: default; }
  .list :global(.tech) { display: flex; align-items: baseline; gap: 8px; color: var(--body); }
  .list :global(.tech::before) { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--line-strong); flex-shrink: 0; transform: translateY(-1px); }
  .list :global(button.hot) { background: var(--surface); color: var(--body); }
  .list :global(button.hot .tech) { color: var(--acc); }
  .list :global(button.hot .tech::before) { background: var(--acc); }
  .summary { display: none; margin: 0; font-size: 13px; color: var(--subtle); }
  .open { font-size: 14px; color: var(--cream); align-self: flex-start; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .open-top { display: none; }

  /* Phones: the phone layout, and the card as a sheet along the bottom. */
  @media (max-width: 719px) {
    .maps :global(.wide) { display: none; }
    .maps :global(.narrow) { display: block; }
    .row { margin-top: 24px; }
    .card { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; gap: 14px; max-height: 70vh; overflow-y: auto; background: #121212; border-top: 1px solid var(--line); border-radius: 16px 16px 0 0; padding: 10px var(--gutter) 24px; }
    .grip { display: block; align-self: center; width: 44px; height: 20px; margin: -6px 0 -8px; padding: 0; background: none; border: 0; cursor: pointer; }
    .grip::before { content: ""; display: block; width: 36px; height: 4px; margin: 0 auto; border-radius: 2px; background: var(--line-strong); }
    .name { font-size: 22px; }
    .head .open-top { display: inline; margin-left: auto; }
    .open-end, .shared { display: none; }
    .meta { margin-top: -8px; }
    .label { display: none; }
    .summary { display: block; }
    :global(body.map-sheet) { padding-bottom: 260px; }
  }

  :global(.terrain .links path) { fill: none; stroke: var(--sel); stroke-width: 1; stroke-dasharray: 1 5; stroke-linecap: round; stroke-opacity: 0.32; transition: stroke-opacity var(--fast) ease; }
  :global(.terrain.focus .links path.hot) { stroke-opacity: 0.7; }
  :global(.terrain.focus .links path:not(.hot)) { stroke-opacity: 0; }
  :global(.terrain.focus .peak.lit:not(.hot) .dot) { fill: #4f4f4f; }
  :global(.terrain.focus .peak.lit:not(.hot) .name) { fill: #7d7d7d; }
</style>

<script>
  import { gsap, T, EASE, reduced } from "../scripts/motion";

  interface P { slug: string; name: string; accent: string; meta: string; tech: string[]; href: string; open: string; work: boolean }
  const DATA: P[] = JSON.parse(document.getElementById("map-data")!.textContent!);
  const row = document.querySelector<HTMLElement>("[data-map]")!;
  const svgs = [...row.querySelectorAll<SVGSVGElement>("svg[data-terrain]")];
  const card = row.querySelector<HTMLElement>("[data-card]")!;
  const $ = <E extends Element>(s: string) => card.querySelector<E>(s)!;
  const NS = "http://www.w3.org/2000/svg";
  const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);
  const pending: gsap.core.Tween[] = [];

  const clear = () => {
    pending.splice(0).forEach((t) => t.kill());
    for (const svg of svgs) {
      svg.querySelector(".links")!.replaceChildren();
      svg.querySelectorAll(".on, .lit, .hot").forEach((n) => n.classList.remove("on", "lit", "hot"));
      svg.classList.remove("focus");
    }
  };

  // The signature: a peak's rings light up from the summit outward, like a ripple.
  const ripple = (slug: string) => {
    for (const svg of svgs) {
      const g = svg.querySelector(`.rings [data-p="${slug}"]`);
      if (!g) continue;
      const uses = [...g.querySelectorAll("use")];
      g.classList.add("on");
      if (reduced()) continue;
      gsap.set(uses, { opacity: 0 });
      pending.push(gsap.to(uses, { opacity: 1, duration: T.base, ease: EASE.enter, stagger: Math.min(0.06, 0.9 / uses.length) }));
    }
  };

  // A soft curve from the picked peak to each project it shares a technology with.
  const link = (svg: SVGSVGElement, from: string, to: string, techs: string[]) => {
    const dot = (s: string) => svg.querySelector<SVGCircleElement>(`.peak[data-slug="${s}"] .dot`)!;
    const [a, b] = [dot(from), dot(to)];
    const x1 = a.cx.baseVal.value, y1 = a.cy.baseVal.value, x2 = b.cx.baseVal.value, y2 = b.cy.baseVal.value;
    const dx = x2 - x1, dy = y2 - y1;
    const path = document.createElementNS(NS, "path");
    path.setAttribute("d", `M${x1} ${y1}Q${(x1 + x2) / 2 - dy * 0.12} ${(y1 + y2) / 2 + dx * 0.12} ${x2} ${y2}`);
    path.dataset.tech = techs.join("|");
    svg.querySelector(".links")!.append(path);
    return path;
  };

  // Pointing at a technology in the card brings forward only the projects that share it.
  const hot = (tech: string | null) => {
    card.querySelectorAll<HTMLElement>("[data-tech]").forEach((b) => b.classList.toggle("hot", b.dataset.tech === tech));
    for (const svg of svgs) {
      svg.classList.toggle("focus", !!tech);
      svg.querySelectorAll<SVGPathElement>(".links path").forEach((l) => {
        const on = !!tech && l.dataset.tech!.split("|").includes(tech);
        l.classList.toggle("hot", on);
        svg.querySelector(`.peak[data-slug="${l.dataset.to}"]`)?.classList.toggle("hot", on);
      });
    }
  };

  const button = (tech: string, ...kids: Node[]) => {
    const b = Object.assign(document.createElement("button"), { type: "button" });
    b.dataset.tech = tech;
    b.append(...kids);
    b.addEventListener("mouseenter", () => hot(tech));
    b.addEventListener("focus", () => hot(tech));
    b.addEventListener("click", () => hot(tech));
    return b;
  };
  const span = (cls: string, text: string) => Object.assign(document.createElement("span"), { className: cls, textContent: text });
  card.addEventListener("mouseleave", () => hot(null));

  const show = (accent: string, name: string, meta: string, href: string, open: string) => {
    for (const el of [row, ...svgs]) el.style.setProperty("--sel", accent);
    card.style.setProperty("--acc", accent);
    $("[data-name]").textContent = name;
    $("[data-meta]").textContent = meta;
    card.querySelectorAll<HTMLAnchorElement>("[data-open]").forEach((a) => { a.href = href; a.textContent = open; });
    const was = card.hidden;
    card.hidden = false;
    document.body.classList.add("map-sheet");
    if (was && !reduced()) gsap.from(card, { autoAlpha: 0, y: 8, duration: T.base, ease: EASE.enter });
  };

  const select = (slug: string, url = true) => {
    const p = DATA.find((d) => d.slug === slug);
    if (!p) return;
    clear();
    for (const svg of svgs) svg.querySelector(`.peak[data-slug="${slug}"]`)!.classList.add("on");
    ripple(slug);
    const shared = new Map<string, string[]>();
    let i = 0;
    for (const o of DATA) {
      if (o.slug === slug) continue;
      const common = o.tech.filter((t) => p.tech.includes(t));
      if (!common.length) continue;
      for (const t of common) shared.set(t, [...(shared.get(t) ?? []), o.name]);
      for (const svg of svgs) {
        svg.querySelector(`.peak[data-slug="${o.slug}"]`)!.classList.add("lit");
        const l = link(svg, slug, o.slug, common);
        l.dataset.to = o.slug;
        if (!reduced()) gsap.from(l, { autoAlpha: 0, duration: T.slow, ease: EASE.enter, delay: 0.2 + i * T.stagger });
      }
      i++;
    }
    show(p.accent, p.name, p.meta, p.href, p.open);
    $("[data-built]").hidden = false;
    $("[data-chips]").replaceChildren(...p.tech.map((t) => button(t, document.createTextNode(t))));
    const group = $("[data-shared-group]");
    group.hidden = false;
    $("[data-shared]").replaceChildren(...[...shared].map(([t, who]) => {
      const li = document.createElement("li");
      li.append(button(t, span("tech", t), span("who", who.join(", "))));
      return li;
    }));
    // Phones get one line: techs shared with the same projects are said together.
    const by = new Map<string, string[]>();
    for (const [t, who] of shared) {
      const k = who.length === 1 ? who[0] : `${who.length} projects`;
      by.set(k, [...(by.get(k) ?? []), t]);
    }
    const parts = [...by].map(([who, ts]) => `${list(ts)} with ${who}`);
    $("[data-summary]").textContent = parts.length
      ? `Shares ${parts.length < 2 ? parts[0] : `${parts.slice(0, -1).join(", ")}, and ${parts[parts.length - 1]}`}`
      : "Nothing here is shared with another project.";
    if (!shared.size) $("[data-shared]").replaceChildren(Object.assign(document.createElement("li"), { className: "none", textContent: "Nothing here is shared with another project." }));
    if (url) history.replaceState(null, "", `?p=${slug}`);
  };

  // A technology from a project page: light every project built with it.
  const focusTech = (tech: string) => {
    const users = DATA.filter((d) => d.tech.includes(tech));
    if (!users.length) return;
    clear();
    for (const u of users) {
      for (const svg of svgs) svg.querySelector(`.peak[data-slug="${u.slug}"]`)!.classList.add("on");
      ripple(u.slug);
    }
    for (const svg of svgs) users.slice(1).forEach((u) => link(svg, users[0].slug, u.slug, [tech]));
    show(users[0].accent, tech, `Used in ${list(users.map((u) => u.name))}.`, users[0].href, `Open ${users[0].name}`);
    $("[data-built]").hidden = true;
    $("[data-shared-group]").hidden = true;
    $("[data-summary]").textContent = "";
  };

  for (const svg of svgs) {
    svg.addEventListener("click", (e) => {
      const g = (e.target as Element).closest<SVGElement>(".peak");
      if (g) { e.preventDefault(); select(g.dataset.slug!); }
    });
  }
  $("[data-close]").addEventListener("click", () => {
    clear();
    card.hidden = true;
    document.body.classList.remove("map-sheet");
    history.replaceState(null, "", location.pathname);
  });

  const q = new URLSearchParams(location.search);
  if (q.get("p")) select(q.get("p")!);
  else if (q.get("t")) focusTech(q.get("t")!);
  // On wide screens the card sits beside the map, so start with the first project picked.
  else if (matchMedia("(min-width: 1100px)").matches && row.dataset.first) select(row.dataset.first, false);
</script>
