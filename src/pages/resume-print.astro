---
// The Resume as a printed A4 document. The browser paginates it inside the @page margins, keeping each
// product's bullets together. scripts/resume-pdf.mjs prints it to public/wassim-soltani-resume.pdf.
// Not linked or indexed; the PDF is what people get.
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/600.css";
import Flow from "../components/Flow.astro";
import { HEADLINE, LOCATION, SUMMARY, JOBS, EDU, SKILLS, LANG, RESUME_PROJECTS } from "../data/resume";
import { SITE } from "../data/site";

const contact = [
  { label: SITE.email, href: `mailto:${SITE.email}` },
  { label: "wsoltani.com", href: SITE.url },
  { label: "linkedin.com/in/wsoltani", href: SITE.linkedin },
  { label: "github.com/wSoltani", href: SITE.github },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Wassim Soltani – Resume</title>
  </head>
  <body>
    <Flow width={1600} height={40} period={24} seed="Wassim Soltani" class="band" style="background:#94288c;color:#0d0d0d" />
        <header>
          <h1>Wassim Soltani</h1>
          <p class="split role"><span>{HEADLINE}</span><span>{LOCATION}</span></p>
          <p class="split contact">{contact.map((c) => <span><a href={c.href}>{c.label}</a></span>)}</p>
        </header>
        <p class="summary">{SUMMARY}</p>

        <h2>Professional Experience</h2>
        {JOBS.map((j) => (
          <article class="job">
            <div class="head"><h3>{j.role}{j.org && <span>, {j.org}</span>}</h3><span class="when">{j.when}</span></div>
            {j.intro && <p class="intro">{j.intro}</p>}
            {j.lead && <ul class="lead">{j.lead.map((l) => <li>{l}</li>)}</ul>}
            {j.groups.map((g) => (
              <div class="group">
                <p><a href={`${SITE.url}/work/${g.slug}`} class="name">{g.name}</a> <span class="context">{g.context}</span></p>
                <ul>{g.items.map((l) => <li>{l}</li>)}</ul>
                {g.stack && <p class="stack">{g.stack.join(", ")}</p>}
              </div>
            ))}
          </article>
        ))}

        <h2>Projects</h2>
        {RESUME_PROJECTS.map((p) => (
          <article class="project">
            <div class="head"><h3><a href={`${SITE.url}/projects/${p.slug}`} class="name">{p.name}</a> <span>{p.category}</span></h3><span class="when">{p.when}</span></div>
            <p class="line">{p.line}</p>
            <p class="split facts">{p.facts.map((f) => <span>{f}</span>)}</p>
          </article>
        ))}
        <p class="older">Older projects at <a href={`${SITE.url}/archive`} class="name">wsoltani.com/archive</a></p>

        <h2>Education</h2>
        {EDU.map((e) => (
          <article class="edu">
            <div><h3>{e.t} <span>{e.o}</span></h3>{e.d && <p class="line">{e.d}</p>}</div>
            <span class="when">{e.w}</span>
          </article>
        ))}

        <h2>Skills</h2>
        <div class="skills">{SKILLS.map(([a, b]) => <div class="skill"><h3>{a}</h3><p class="tags">{b.map((t, i) => <>{i > 0 && ", "}<span>{t}</span></>)}</p></div>)}</div>

        <h2>Languages</h2>
        <p class="split langs">{LANG.map(([a, b]) => <span><strong>{a}</strong> {b}</span>)}</p>
  </body>
</html>

<style is:global>
  /* Side margins come from the body padding, so the band on page 1 can run edge to edge. */
  @page { size: A4; margin: 12mm 0; background: #faf8f3; }
  @page :first { margin-top: 0; }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; font-family: "Instrument Sans", sans-serif; font-size: 12px; line-height: 1.35; color: #1a1a1a; background: #faf8f3; }
  a { color: inherit; text-decoration: none; }
  p, ul, h1, h2, h3, dl { margin: 0; }
  /* A thin strip on the top edge of page 1, bleeding past the side margins. */
  .band { display: block; width: calc(100% + 26mm); height: 5mm; margin: 0 -13mm; }
  @media print { body { padding: 0 13mm; } }
  header { margin-top: 12mm; display: flex; flex-direction: column; gap: 4px; }
  h1 { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; color: #0d0d0d; }
  /* Items split by a thin rule, never a visible typed separator. Every item has the rule in front and is
     shifted left by one rule, and the row clips that strip off, so a wrapped line never starts with one.
     Clipped with overflow, not clip-path, which Chrome paints last and so moves to the end of the PDF's
     text. The invisible " | " gives text readers a separator. */
  .split { display: flex; flex-wrap: wrap; row-gap: 2px; overflow-x: clip; }
  .split > span { margin: 0 11px 0 -11px; border-left: 1px solid #cfc6b8; padding-right: 10px; }
  .split > span::before { content: " | "; display: inline-block; width: 10px; white-space: pre; color: transparent; }
  .role { font-size: 13px; color: #555; }
  .contact { font-size: 11.5px; color: #444; }
  .summary { margin-top: 10px; color: #333; }
  h2 { margin-top: 14px; padding-bottom: 5px; border-bottom: 1px solid #d8d0c4; font-size: 14px; font-weight: 600; color: #0d0d0d; break-after: avoid; }
  h3 { font-size: 13px; font-weight: 600; color: #0d0d0d; }
  h3 span { color: #666; font-weight: 400; }
  .head { display: flex; justify-content: space-between; gap: 16px; break-after: avoid; }
  .when { flex-shrink: 0; font-size: 11.5px; color: #666; white-space: nowrap; }
  .job { margin-top: 8px; }
  .intro { margin-top: 1px; color: #555; break-after: avoid; }
  .lead { margin-top: 3px; break-inside: avoid; }
  .group { margin-top: 4px; break-inside: avoid; }
  .name { font-weight: 600; text-decoration: underline; text-decoration-color: #cfc6b8; text-underline-offset: 2px; }
  .context { color: #666; margin-left: 4px; }
  ul { margin-top: 1px; padding-left: 15px; color: #333; }
  .project { margin-top: 5px; break-inside: avoid; }
  .line { margin-top: 1px; color: #333; }
  .facts, .stack { margin-top: 1px; font-size: 11.5px; color: #666; }
  .stack { padding-left: 15px; }
  .older { margin-top: 6px; font-size: 11.5px; color: #666; }
  .edu { margin-top: 5px; display: flex; justify-content: space-between; gap: 16px; break-inside: avoid; }
  .skills { margin-top: 8px; color: #333; }
  .skill h3 { font-size: 12px; }
  .langs { margin-top: 8px; color: #555; }
  .langs strong { font-weight: 600; color: #0d0d0d; margin-right: 4px; }
  /* Groups in three columns, each a bold label over a comma list. */
  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 24px; }
  /* A term never breaks across lines, so a reader going across the columns can't split it. */
  .tags span { white-space: nowrap; }
  @media screen { body { max-width: 210mm; margin: 0 auto; padding: 0 13mm 13mm; } }
</style>
