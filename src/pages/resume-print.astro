---
// The Resume as a printed document: two A4 sheets, experience on the first and the rest on the second.
// scripts/resume-pdf.mjs prints this page to public/wassim-soltani-resume.pdf. Each sheet is a fixed A4 page,
// so after changing the content, open /resume-print and check that nothing runs past the bottom of either sheet.
// Not linked or indexed; the PDF is what people get.
import "@fontsource-variable/instrument-sans/wdth.css";
import Flow from "../components/Flow.astro";
import { HEADLINE, LOCATION, SUMMARY, JOBS, EDU, SKILLS, LANG, RESUME_PROJECTS } from "../data/resume";
import { SITE } from "../data/site";

const contact = [
  { label: SITE.email, href: `mailto:${SITE.email}` },
  { label: "wsoltani.com", href: SITE.url },
  { label: "linkedin.com/in/wsoltani", href: SITE.linkedin },
  { label: "github.com/wSoltani", href: SITE.github },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Wassim Soltani – Resume</title>
  </head>
  <body>
    <div class="sheet" data-sheet>
      <Flow width={794} height={24} seed="Wassim Soltani" class="band" style="background:#faf8f3;color:#e4ddd2" />
      <div class="inner first">
        <header>
          <div class="who">
            <h1>Wassim Soltani</h1>
            <p class="split role"><span>{HEADLINE}</span><span>{LOCATION}</span></p>
          </div>
          <ul class="contact">{contact.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
        </header>
        <p class="summary">{SUMMARY}</p>

        <h2>Experience</h2>
        {JOBS.map((j) => (
          <article class="job">
            <div class="head"><h3>{j.role}{j.org && <span>, {j.org}</span>}</h3><span class="when">{j.when}</span></div>
            {j.intro && <p class="intro">{j.intro}</p>}
            {j.lead && <ul class="lead">{j.lead.map((l) => <li>{l}</li>)}</ul>}
            {j.groups.map((g) => (
              <>
                <p class="group"><a href={`${SITE.url}/work/${g.slug}`} class="name">{g.name}</a> <span class="context">{g.context}</span></p>
                <ul>{g.items.map((l) => <li>{l}</li>)}</ul>
              </>
            ))}
          </article>
        ))}
      </div>
    </div>

    <div class="sheet" data-sheet>
      <div class="inner">
        <h2 class="lead-h">Projects</h2>
        {RESUME_PROJECTS.map((p) => (
          <article class="project">
            <div class="head"><h3><a href={`${SITE.url}/projects/${p.slug}`} class="name">{p.name}</a> <span>{p.category}</span></h3><span class="when">{p.when}</span></div>
            <p class="line">{p.line}</p>
            <p class="split facts">{p.facts.map((f) => <span>{f}</span>)}</p>
          </article>
        ))}
        <p class="older">Older projects at <a href={`${SITE.url}/archive`} class="name">wsoltani.com/archive</a></p>

        <h2>Education</h2>
        {EDU.map((e) => (
          <article class="edu">
            <div><h3>{e.t} <span>{e.o}</span></h3>{e.d && <p class="line">{e.d}</p>}</div>
            <span class="when">{e.w}</span>
          </article>
        ))}

        <h2>Skills</h2>
        <dl>{SKILLS.map(([a, b]) => <><dt>{a}</dt><dd>{b}</dd></>)}</dl>

        <h2>Languages</h2>
        <dl>{LANG.map(([a, b]) => <><dt>{a}</dt><dd>{b}</dd></>)}</dl>
      </div>
    </div>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; font-family: "Instrument Sans Variable", "Instrument Sans", sans-serif; font-size: 12px; line-height: 1.38; color: #1a1a1a; background: #faf8f3; }
  a { color: inherit; text-decoration: none; }
  p, ul, h1, h2, h3, dl { margin: 0; }
  .sheet { width: 210mm; height: 297mm; overflow: hidden; background: #faf8f3; break-after: page; }
  .sheet:last-child { break-after: auto; }
  .band { display: block; width: 100%; height: 24px; }
  .inner { padding: 40px 48px 0; }
  .inner.first { padding-top: 20px; }
  header { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .who { display: flex; flex-direction: column; gap: 3px; }
  h1 { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; color: #0d0d0d; }
  /* Items split by a thin rule, never a typed separator. */
  .split { display: flex; flex-wrap: wrap; row-gap: 2px; margin-left: -11px; clip-path: inset(-4px -4px -4px 11px); }
  .split > span { border-left: 1px solid #cfc6b8; padding: 0 10px; }
  .role { font-size: 13px; color: #555; }
  .contact { list-style: none; padding: 0; text-align: right; font-size: 11.5px; color: #444; line-height: 1.55; }
  .summary { margin-top: 12px; color: #333; }
  h2 { margin-top: 18px; padding-bottom: 5px; border-bottom: 1px solid #d8d0c4; font-size: 14px; font-weight: 600; color: #0d0d0d; }
  h2.lead-h { margin-top: 0; }
  h3 { font-size: 13px; font-weight: 600; color: #0d0d0d; }
  h3 span { color: #666; font-weight: 400; }
  .head { display: flex; justify-content: space-between; gap: 16px; }
  .when { flex-shrink: 0; font-size: 11.5px; color: #666; white-space: nowrap; }
  .job { margin-top: 10px; }
  .intro { margin-top: 1px; color: #555; }
  .lead { margin-top: 3px; }
  .group { margin-top: 5px; }
  .name { font-weight: 600; text-decoration: underline; text-decoration-color: #cfc6b8; text-underline-offset: 2px; }
  .context { color: #666; margin-left: 4px; }
  ul { margin-top: 1px; padding-left: 15px; color: #333; }
  .project { margin-top: 7px; }
  .line { margin-top: 1px; color: #333; }
  .facts { margin-top: 1px; font-size: 11.5px; color: #666; }
  .older { margin-top: 6px; font-size: 11.5px; color: #666; }
  .edu { margin-top: 7px; display: flex; justify-content: space-between; gap: 16px; }
  dl { margin-top: 7px; display: grid; grid-template-columns: 120px 1fr; gap: 3px 16px; color: #333; }
  dt { color: #666; }
  dd { margin: 0; }
  @media screen { body { background: #e9e5dc; } .sheet { margin: 16px auto; box-shadow: 0 1px 3px rgb(0 0 0 / 0.15); } }
</style>
