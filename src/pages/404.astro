---
import Base from "../layouts/Base.astro";
import Flow from "../components/Flow.astro";
---

<Base title="Nothing here" description="This page doesn't exist." noindex>
  <div class="wrap nf">
    <div class="text">
      <h1 class="h1" data-title>404<br />Nothing here</h1>
      <p class="sub">This pattern is made from the address you typed, so at least you got that. <span class="cool">Isn't that cool?</span></p>
      <div class="actions">
        <a href="/" class="btn">Back home</a>
        <button type="button" class="btn btn-outline nope" data-nope>No, it's not</button>
      </div>
    </div>
    <div class="art" data-404>
      <Flow width={520} height={520} seed="/404" class="pat" />
    </div>
  </div>
</Base>

<style>
  .nf { padding-top: 96px; display: grid; grid-template-columns: 1fr 520px; gap: 64px; align-items: center; }
  .text { display: flex; flex-direction: column; gap: 20px; }
  .sub { font-size: 22px; line-height: 1.5; color: var(--body); max-width: 34ch; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .cool { color: var(--text); }
  /* Solid, so it stays readable wherever it lands, stripes included. Same weight as its neighbor. */
  .nope { position: relative; z-index: 10; will-change: transform; font-weight: 600; background: var(--raised); border-color: #5a5a5a; }
  .nope:hover { background: var(--raised); }
  .art :global(.pat) { width: 100%; aspect-ratio: 1; height: auto; border-radius: 12px; }
  @media (max-width: 1023px) { .nf { grid-template-columns: 1fr; gap: 40px; } .art { max-width: 520px; } .sub { font-size: 19px; } }
</style>

<script>
  import { flowPath } from "../lib/flowlines";
  import { gsap, settle, reduced } from "../scripts/motion";
  // Seeded by the address that was typed, so every missing page has its own pattern.
  // The page's signature: the stripes swirl into that pattern from straight.
  const svg = document.querySelector<SVGSVGElement>("[data-404] svg");
  if (svg) {
    svg.dataset.seed = location.pathname.toLowerCase();
    if (reduced()) svg.querySelector("path")!.setAttribute("d", flowPath({ width: 520, height: 520, seed: svg.dataset.seed }));
    else settle(svg, { duration: 1.4, from: 0, delay: 0.15 });
  }

  const no = document.querySelector<HTMLButtonElement>("[data-nope]")!;
  const ESCAPES = 8;
  const RECOVER_AFTER = 10;
  const RECOVER_RATE = 1 / 3;
  const BREATHE = true;
  const fresh = { far: 320, glide: 1.6, rest: 0.5, reach: 60, hop: 160, overshoot: 1.2 };
  const tired = { far: 120, glide: 2.6, rest: 1.4, reach: 20, hop: 70, overshoot: 2.6 };

  let spent = 0;
  let caught = false;
  let awake = false;
  let moving = false;
  let lastChase = 0;
  let breath: ReturnType<typeof gsap.to> | null = null;
  const tiredness = () => Math.min(1, spent / (ESCAPES - 1));
  const lerp = (k: keyof typeof fresh) => fresh[k] + (tired[k] - fresh[k]) * tiredness();
  const stopBreathing = () => { breath?.kill(); breath = null; gsap.set(no, { scale: 1 }); };
  const breathe = () => {
    if (!BREATHE || caught || breath || tiredness() < 0.5 || reduced()) return;
    breath = gsap.to(no, { scale: 1.015, duration: 1.2, ease: "sine.inOut", yoyo: true, repeat: -1 });
  };
  const home = (r: DOMRect) => ({ left: r.left - (gsap.getProperty(no, "x") as number), top: r.top - (gsap.getProperty(no, "y") as number) });
  const pick = (r: DOMRect, px: number, py: number, hop: boolean) => {
    const pad = 16, top = 88;
    const maxX = Math.max(pad, innerWidth - r.width - pad), maxY = Math.max(top, innerHeight - r.height - pad);
    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    let tx = r.left, ty = r.top;
    for (let i = 0; i < 30; i++) {
      if (hop) {
        const a = Math.random() * Math.PI * 2, d = lerp("hop") * (0.8 + Math.random() * 0.4);
        tx = clamp(r.left + Math.cos(a) * d, pad, maxX);
        ty = clamp(r.top + Math.sin(a) * d, top, maxY);
        if (Math.hypot(tx - r.left, ty - r.top) > lerp("hop") * 0.6) break;
      } else {
        tx = pad + Math.random() * (maxX - pad);
        ty = top + Math.random() * (maxY - top);
        if (Math.hypot(tx + r.width / 2 - px, ty + r.height / 2 - py) > lerp("far")) break;
      }
    }
    return { x: tx - home(r).left, y: ty - home(r).top };
  };

  const giveUp = () => {
    caught = true;
    stopBreathing();
    if (reduced()) return;
    gsap.timeline()
      .to(no, { y: "+=6", scaleY: 0.9, scaleX: 1.05, rotation: 0, duration: 0.18, ease: "power2.in" })
      .to(no, { scaleY: 0.96, scaleX: 1.02, duration: 0.4, ease: "power2.out" });
  };

  const flee = (px: number, py: number, hop = false) => {
    if (caught) return;
    awake = true;
    lastChase = performance.now();
    stopBreathing();
    const r = no.getBoundingClientRect();
    const to = pick(r, px, py, hop);
    const rest = lerp("rest");
    spent = Math.floor(spent) + 1;
    const last = spent >= ESCAPES;
    if (reduced()) {
      gsap.set(no, to);
      if (last) giveUp();
      return;
    }
    moving = true;
    const away = Math.sign(r.left + r.width / 2 - px) || 1;
    gsap.timeline({ overwrite: true, onComplete: () => (last ? giveUp() : breathe()) })
      .to(no, { rotation: 6 * away, duration: 0.12, ease: "power2.out" })
      .to(no, { ...to, duration: hop ? 0.5 + 0.3 * tiredness() : lerp("glide"), ease: `back.out(${lerp("overshoot")})` })
      .to(no, { rotation: 0, duration: 0.4, ease: "power2.out" }, "<0.1");
    gsap.delayedCall(0.12 + rest, () => (moving = false));
  };
  let pointer: { x: number; y: number } | null = null;
  addEventListener("pointermove", (e) => { if (e.pointerType === "mouse") pointer = { x: e.clientX, y: e.clientY }; });
  document.documentElement.addEventListener("pointerleave", () => (pointer = null));
  gsap.ticker.add((_t, dt) => {
    if (caught) return;
    if (awake && spent > 0 && performance.now() - lastChase > RECOVER_AFTER * 1000) {
      spent = Math.max(0, spent - RECOVER_RATE * dt / 1000);
      if (tiredness() < 0.5) stopBreathing();
    }
    if (moving || !pointer) return;
    const r = no.getBoundingClientRect();
    const dx = Math.max(r.left - pointer.x, 0, pointer.x - r.right);
    const dy = Math.max(r.top - pointer.y, 0, pointer.y - r.bottom);
    if (Math.hypot(dx, dy) < (awake ? lerp("reach") : 1)) flee(pointer.x, pointer.y);
  });
  no.addEventListener("pointerdown", (e) => {
    if (caught) return;
    e.preventDefault();
    if (!moving) flee(e.clientX, e.clientY, e.pointerType !== "mouse");
  });
  no.addEventListener("click", (e) => {
    e.preventDefault();
    if (caught) return;
    if (moving) return;
    const r = no.getBoundingClientRect();
    flee(r.left + r.width / 2, r.top + r.height / 2, e.detail === 0);
  });
  addEventListener("resize", () => {
    const r = no.getBoundingClientRect();
    if (r.right <= innerWidth && r.bottom <= innerHeight) return;
    if (!caught) return flee(innerWidth / 2, innerHeight / 2);
    gsap.set(no, { x: 0, y: 0 });
  });
</script>
